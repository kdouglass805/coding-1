def dice_game():
    score = 0
    choice = input("Enter 'r' to roll or 'q' to quit: ").lower()

    while choice == 'r':
        roll = random.randint(1, 7)
        print(f"You rolled: {roll}")

        if roll == 7:
            score += 10
            print("You win! +10 points")
        else:
            score -= 5
            print("You lost! -5 points")

        print(f"Current score: {score}")
        choice = input("Roll again? (r to roll, q to quit): ").lower()

    print(f"Game over! Final score: {score}")







def game():
    player_score = 0
    cpu_score = 0
    rounds = 0

    while rounds < 3:
        player = input("Choose r, p, s, or q: ")

        if player == "q":
            break

        if player not in ["r", "p", "s"]:
            print("Invalid choice!")
            continue

        cpu = ["r", "p", "s"][randint(0, 2)]
        print("Computer chose:", cpu)

        if player == cpu:
            print("Tie!")
        elif (player == "r" and cpu == "s") or \
             (player == "p" and cpu == "r") or \
             (player == "s" and cpu == "p"):
            print("You win!")
            player_score += 1
        else:
            print("Computer wins!")
            cpu_score += 1

        rounds += 1

    print("Your score:", player_score)
    print("Computer score:", cpu_score)

game()




